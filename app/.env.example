# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 커밋하지 마세요)

# ── 필수 ─────────────────────────────────────────────
# Anthropic Claude API 키 — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── 모델 / 튜닝 ──────────────────────────────────────
# 기본값은 claude-opus-5. 이 챗봇 용도(짧은 한국어 해석문, 대량·저지연)엔
# 아래 중 하나로 바꾸는 걸 권장 (1M 토큰당 입력/출력):
#   claude-haiku-4-5   $1 / $5   ← 가장 저렴, 이 용도에 충분
#   claude-sonnet-5    $2 / $10  ← 품질·비용 균형
#   claude-opus-5      $5 / $25  ← 과함
ANTHROPIC_MODEL=claude-haiku-4-5
CHAT_MAX_TOKENS=1024
CHANNEL_NAME=천명재
DEFAULT_CITY=Seoul

# 대화 기록 유지 개수(user+assistant 합산). 길수록 맥락 좋아지지만 토큰 비용 증가.
HISTORY_MAX_TURNS=20

# 세션 DB 경로(sqlite). 배포 시 영구 디스크 경로로.
SESSION_DB=sessions.db

# ── 웹훅 보안 ────────────────────────────────────────
# /api/*, /webhook/* POST 요청에 X-Webhook-Secret 헤더로 이 값을 요구.
# 비우면 검증 건너뜀(로컬 테스트만). 매니챗 External Request 에 커스텀 헤더로 넣기.
WEBHOOK_SECRET=

# ── (선택) Meta 공식 Instagram Messaging API 를 직접 붙일 때만 ──
META_VERIFY_TOKEN=change-me
META_PAGE_ACCESS_TOKEN=
